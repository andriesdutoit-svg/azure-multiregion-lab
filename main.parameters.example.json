{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "prefix": {
      "value": "AMRL"
    },

    "stage": {
      "value": "all"
    },

    "tags": {
      "value": {
        "environment": "lab"
      }
    },

    "regionIndexMap": {
      "value": {
        "southafricanorth": 1,
        "centralindia": 2,
        "malaysiawest": 3,
        "belgiumcentral": 4,
        "indonesiacentral": 5,
        "polandcentral": 6,
        "australiasoutheast": 7,
        "japaneast": 8,
        "spaincentral": 9,
        "denmarkeast": 10,
        "swedencentral": 11,
        "koreacentral": 12,
        "canadaeast": 13,
        "southindia": 14,
        "uaenorth": 15,
        "australiaeast": 16,
        "mexicocentral": 17,
        "eastasia": 18,
        "southeastasia": 19,
        "koreasouth": 20,
        "austriaeast": 21,
        "westcentralus": 22,
        "israelcentral": 23,
        "newzealandnorth": 24,
        "chilecentral": 25,
        "japanwest": 26,
        "westus2": 27
      }
    },

    "subnetIndexMap": {
      "value": {
        "firewall": 0,
        "jumpbox": 1,
        "dc": 2,
        "server": 3,
        "client": 4
      }
    },

    "regionCount": {
      "value": 3
    },

    "maxVmsPerRegion": {
      "value": 2
    },

    "vmCounts": {
      "value": {
        "dc": 1,
        "jumpbox": 1,
        "windowsServer": 1,
        "windowsClient": 1,
        "linuxServer": 1,
        "linuxClient": 1
      }
    },

    "jumpboxAllowedSources": {
      "value": [
        "<your-public-ip>",
        "<your-public-cidr-range>"
      ]
    },

    "enableClientSsh": {
      "value": true
    },

    "enableIdentity": {
      "value": false
    },

    "existingRegions": {
      "value": []
    },

    "domainName": {
      "value": "amrl.lab"
    },

    "usersPerDepartment": {
      "value": 10
    },

    "sysAdminDepartment": {
      "value": {
        "Information Technology": "ICT"
      }
    },

    "additionalDepartments": {
      "value": {
        "Finance": "FIN",
        "Human Resources": "HR",
        "Sales": "SAL",
        "Engineering": "ENG",
        "Operations": "OPS",
        "Marketing": "MAR",
        "Legal": "LEG",
        "Procurement": "PRO",
        "Research": "RES",
        "Support": "SUP"
      }
    },

    "departmentCount": {
      "value": 10
    },

    "windowsServerImage": {
      "value": {
        "publisher": "MicrosoftWindowsServer",
        "offer": "WindowsServer",
        "sku": "2022-datacenter-g2",
        "version": "latest"
      }
    },

    "windowsClientImage": {
      "value": {
        "publisher": "MicrosoftWindowsDesktop",
        "offer": "windows-10",
        "sku": "win10-22h2-ent-g2",
        "version": "latest"
      }
    },

    "ubuntuImage": {
      "value": {
        "publisher": "Canonical",
        "offer": "0001-com-ubuntu-server-jammy",
        "sku": "22_04-lts-gen2",
        "version": "latest"
      }
    },

    "vmSizes": {
      "value": {
        "dc": "<vm-size-for-dc>",
        "jumpbox": "<vm-size-for-jumpbox>",
        "windowsServer": "<vm-size-for-windows-server>",
        "windowsClient": "<vm-size-for-windows-client>",
        "linuxServer": "<vm-size-for-linux-server>",
        "linuxClient": "<vm-size-for-linux-client>"
      }
    },

    "osDisks": {
      "value": {
        "dc": {
          "storageAccountType": "<os-disk-sku-for-dc>",
          "diskSizeGB": 128
        },
        "jumpbox": {
          "storageAccountType": "<os-disk-sku-for-jumpbox>",
          "diskSizeGB": 128
        },
        "windowsServer": {
          "storageAccountType": "<os-disk-sku-for-windows-server>",
          "diskSizeGB": 128
        },
        "windowsClient": {
          "storageAccountType": "<os-disk-sku-for-windows-client>",
          "diskSizeGB": 128
        },
        "linuxServer": {
          "storageAccountType": "<os-disk-sku-for-linux-server>",
          "diskSizeGB": 128
        },
        "linuxClient": {
          "storageAccountType": "<os-disk-sku-for-linux-client>",
          "diskSizeGB": 128
        }
      }
    },

    "vmAutoDeleteOptions": {
      "value": {
        "nic": true,
        "publicIp": true,
        "osDisk": true
      }
    },

    "adminPublicKey": {
      "value": "ssh-ed25519 <public-key>"
    },
    "jumpboxAdminUsername": {
      "value": "azureadmin"
    },
    "jumpboxAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<subscription-id>/resourceGroups/<foundation-rg>/providers/Microsoft.KeyVault/vaults/<key-vault-name>"
        },
        "secretName": "jumpboxAdminPassword"
      }
    },
    "serverAdminUsername": {
      "value": "azureadmin"
    },
    "serverAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<subscription-id>/resourceGroups/<foundation-rg>/providers/Microsoft.KeyVault/vaults/<key-vault-name>"
        },
        "secretName": "serverAdminPassword"
      }
    },
    "clientAdminUsername": {
      "value": "azureadmin"
    },
    "clientAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<subscription-id>/resourceGroups/<foundation-rg>/providers/Microsoft.KeyVault/vaults/<key-vault-name>"
        },
        "secretName": "clientAdminPassword"
      }
    }
  }
}
