{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "prefix": {
      "value": "AMRL"
    },

    "stage": {
      "value": "all"
    },

    "tags": {
      "value": {
        "environment": "lab"
      }
    },

    "regionIndexMap": {
      "value": {
        "southafricanorth": 1,
        "centralindia": 2,
        "malaysiawest": 3,
        "belgiumcentral": 4,
        "indonesiacentral": 5,
        "polandcentral": 6,
        "australiasoutheast": 7,
        "japaneast": 8,
        "spaincentral": 9,
        "denmarkeast": 10,
        "swedencentral": 11,
        "koreacentral": 12,
        "canadaeast": 13,
        "southindia": 14,
        "uaenorth": 15,
        "australiaeast": 16,
        "mexicocentral": 17,
        "eastasia": 18,
        "koreasouth": 19,
        "austriaeast": 20,
        "westcentralus": 21,
        "israelcentral": 22,
        "newzealandnorth": 23,
        "chilecentral": 24,
        "japanwest": 25,
        "westus2": 26
      }
    },

    "subnetIndexMap": {
      "value": {
        "firewall": 0,
        "jumpbox": 1,
        "dc": 2,
        "server": 3,
        "client": 4
      }
    },

    "regionCount": {
      "value": 3
    },

    "maxVmsPerRegion": {
      "value": 2
    },

    "vmCounts": {
      "value": {
        "dc": 1,
        "jumpbox": 1,
        "windowsServer": 1,
        "windowsClient": 1,
        "linuxServer": 1,
        "linuxClient": 1
      }
    },

    "jumpboxAllowedSources": {
      "value": [
        "<YOUR_PUBLIC_IP>/32"
      ]
    },

    "enableClientSsh": {
      "value": true
    },

    "enableIdentity": {
      "value": false
    },

    "existingRegions": {
      "value": []
    },

    "existingVmPlacements": {
      "value": []
    },

    "domainName": {
      "value": "amrl.lab"
    },

    "usersPerDepartment": {
      "value": 10
    },

    "sysAdminDepartment": {
      "value": {
        "Information Technology": "ICT"
      }
    },

    "additionalDepartments": {
      "value": {
        "Finance": "FIN",
        "Human Resources": "HR",
        "Sales": "SAL",
        "Engineering": "ENG",
        "Operations": "OPS",
        "Marketing": "MAR",
        "Legal": "LEG",
        "Procurement": "PRO",
        "Research": "RES",
        "Support": "SUP"
      }
    },

    "departmentCount": {
      "value": 10
    },

    "windowsServerImage": {
      "value": {
        "publisher": "MicrosoftWindowsServer",
        "offer": "WindowsServer",
        "sku": "2022-datacenter-g2",
        "version": "latest"
      }
    },

    "windowsClientImage": {
      "value": {
        "publisher": "MicrosoftWindowsDesktop",
        "offer": "windows-10",
        "sku": "win10-22h2-ent-g2",
        "version": "latest"
      }
    },

    "ubuntuImage": {
      "value": {
        "publisher": "Canonical",
        "offer": "0001-com-ubuntu-server-jammy",
        "sku": "22_04-lts-gen2",
        "version": "latest"
      }
    },

    "vmSizes": {
      "value": {
        "dc": "Standard_B2ls_v2",
        "jumpbox": "Standard_B2ls_v2",
        "windowsServer": "Standard_B2ls_v2",
        "windowsClient": "Standard_B2ls_v2",
        "linuxServer": "Standard_B2ls_v2",
        "linuxClient": "Standard_B2ls_v2"
      }
    },

    "osDisks": {
      "value": {
        "dc": {
          "storageAccountType": "Premium_LRS",
          "diskSizeGB": 128
        },
        "jumpbox": {
          "storageAccountType": "StandardSSD_LRS",
          "diskSizeGB": 64
        },
        "windowsServer": {
          "storageAccountType": "Premium_LRS",
          "diskSizeGB": 128
        },
        "windowsClient": {
          "storageAccountType": "StandardSSD_LRS",
          "diskSizeGB": 64
        },
        "linuxServer": {
          "storageAccountType": "Premium_LRS",
          "diskSizeGB": 128
        },
        "linuxClient": {
          "storageAccountType": "StandardSSD_LRS",
          "diskSizeGB": 64
        }
      }
    },

    "vmAutoDeleteOptions": {
      "value": {
        "nic": true,
        "publicIp": true,
        "osDisk": true
      }
    },

    "sshPublicKey": {
      "reference": {
        "keyVault": {
          "id": "<KEYVAULT_ID>"
        },
        "secretName": "sshPublicKey"
      }
    },

    "sshPrivateKey": {
      "reference": {
        "keyVault": {
          "id": "<KEYVAULT_ID>"
        },
        "secretName": "sshPrivateKey"
      }
    },

    "jumpboxAdminUsername": {
      "value": "azureadmin"
    },

    "jumpboxAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "<KEYVAULT_ID>"
        },
        "secretName": "jumpboxAdminPassword"
      }
    },

    "serverAdminUsername": {
      "value": "azureadmin"
    },

    "serverAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "<KEYVAULT_ID>"
        },
        "secretName": "serverAdminPassword"
      }
    },

    "clientAdminUsername": {
      "value": "azureadmin"
    },

    "clientAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "<KEYVAULT_ID>"
        },
        "secretName": "clientAdminPassword"
      }
    }
  }
}
