{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.15.27210",
      "templateHash": "13886829145301580647"
    }
  },
  "parameters": {
    "vnetName": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "deploySubnets": {
      "type": "bool"
    },
    "addressPrefix": {
      "type": "string"
    },
    "subnetPrefix": {
      "type": "object"
    },
    "isHub": {
      "type": "bool"
    },
    "dnsServers": {
      "type": "array"
    },
    "jumpboxSubnets": {
      "type": "array"
    },
    "existingRegions": {
      "type": "array",
      "defaultValue": []
    },
    "jumpboxAllowedSources": {
      "type": "array"
    },
    "enableClientSsh": {
      "type": "bool"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    }
  },
  "variables": {
    "isExistingRegion": "[contains(parameters('existingRegions'), parameters('location'))]",
    "createSubnets": "[not(variables('isExistingRegion'))]",
    "internalNetworkRange": "10.0.0.0/8",
    "adRules": [
      {
        "name": "Allow-DNS",
        "port": "53",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-Kerberos",
        "port": "88",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-LDAP",
        "port": "389",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      }
    ],
    "adAdvancedRules": [
      {
        "name": "Allow-NTP",
        "port": "123",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-Kerberos-Password-Change",
        "port": "464",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-SMB",
        "port": "445",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-Global-Catalog",
        "port": "3268",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-Global-Catalog-SSL",
        "port": "3269",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-LDAPS",
        "port": "636",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-RPC-Endpoint-Mapper",
        "port": "135",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      },
      {
        "name": "Allow-RPC-Dynamic",
        "port": "49152-65535",
        "access": "Allow",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      }
    ],
    "rdpRules": [
      {
        "name": "Allow-RDP-From-Jumpbox",
        "port": "3389",
        "access": "Allow",
        "source": "[parameters('jumpboxSubnets')]"
      },
      {
        "name": "Deny-RDP-From-Others",
        "port": "3389",
        "access": "Deny",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      }
    ],
    "sshRules": [
      {
        "name": "Allow-SSH-From-Jumpbox",
        "port": "22",
        "access": "Allow",
        "source": "[parameters('jumpboxSubnets')]"
      },
      {
        "name": "Deny-SSH-From-Others",
        "port": "22",
        "access": "Deny",
        "source": [
          "[variables('internalNetworkRange')]"
        ]
      }
    ],
    "nsgRules": {
      "dc": "[concat(variables('adRules'), variables('adAdvancedRules'), variables('rdpRules'))]",
      "jumpbox": [
        {
          "name": "Allow-RDP-From-Approved-Internet",
          "port": "3389",
          "access": "Allow",
          "source": "[parameters('jumpboxAllowedSources')]"
        }
      ],
      "server": "[concat(variables('sshRules'), variables('rdpRules'), variables('adRules'))]",
      "client": "[concat(if(parameters('enableClientSsh'), variables('sshRules'), createArray()), variables('rdpRules'))]"
    },
    "subnetNames": {
      "dc": "[format('{0}-subnet-dc', parameters('vnetName'))]",
      "server": "[format('{0}-subnet-server', parameters('vnetName'))]",
      "client": "[format('{0}-subnet-client', parameters('vnetName'))]",
      "jumpbox": "[format('{0}-subnet-jumpbox', parameters('vnetName'))]"
    },
    "clientSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), format('{0}-subnet-client', parameters('vnetName')))]",
    "dcSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), format('{0}-subnet-dc', parameters('vnetName')))]",
    "jumpboxSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), format('{0}-subnet-jumpbox', parameters('vnetName')))]",
    "serverSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), format('{0}-subnet-server', parameters('vnetName')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2022-07-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('addressPrefix')]"
          ]
        },
        "dhcpOptions": {
          "dnsServers": "[parameters('dnsServers')]"
        }
      }
    },
    {
      "condition": "[variables('createSubnets')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('{0}-nsg-dc', parameters('vnetName'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "nsgName": {
            "value": "[format('{0}-nsg-dc', parameters('vnetName'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[union(parameters('tags'), createObject('role', 'dc-nsg'))]"
          },
          "rules": {
            "value": "[variables('nsgRules').dc]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
