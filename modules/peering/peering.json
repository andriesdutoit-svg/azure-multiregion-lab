{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "8300990829539290044"
    }
  },
  "parameters": {
    "vnetName": {
      "type": "string"
    },
    "regionKeys": {
      "type": "array"
    },
    "sourceRegion": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "hubRegion": {
      "type": "string"
    }
  },
  "resources": [
    {
      "copy": {
        "name": "peerings",
        "count": "[length(parameters('regionKeys'))]"
      },
      "condition": "[or(and(equals(parameters('sourceRegion'), parameters('hubRegion')), not(equals(parameters('regionKeys')[copyIndex()], parameters('hubRegion')))), and(not(equals(parameters('sourceRegion'), parameters('hubRegion'))), equals(parameters('regionKeys')[copyIndex()], parameters('hubRegion'))))]",
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', parameters('vnetName'), format('{0}-to-{1}-vnet-{2}', parameters('vnetName'), parameters('prefix'), parameters('regionKeys')[copyIndex()]))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId(format('{0}-rg-{1}', parameters('prefix'), parameters('regionKeys')[copyIndex()]), 'Microsoft.Network/virtualNetworks', format('{0}-vnet-{1}', parameters('prefix'), parameters('regionKeys')[copyIndex()]))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": true,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      }
    }
  ]
}